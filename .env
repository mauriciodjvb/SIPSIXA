# Copia este archivo con el nombre ".env" y cambia los valores.
# NUNCA subas el archivo .env a git.
# Usa solo letras y números en las contraseñas (evita @ : / # ).

MYSQL_DATABASE=sipsixa_db
MYSQL_USER=sipsixa_user
MYSQL_PASSWORD=1234
MYSQL_ROOT_PASSWORD=1234

# Clave para firmar los tokens JWT: pon una cadena larga y aleatoria
JWT_SECRET_KEY=Mauricio21

# 1 = modo desarrollo (recarga plantillas), 0 = normal
FLASK_DEBUG=1
